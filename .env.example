# ========================================================
# AxelRemoteBot - Control Remoto de PC & Antigravity IDE
# Plantilla de ejemplo para Portainer / Docker / Local
# ========================================================

# ---------- SERVIDOR WEB ----------
PORT=3005
NODE_ENV=production
TZ=America/Lima

# ---------- TELEGRAM BOT (@AxelRemotebot) ----------
# Token del bot obtenido de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui

# Tu Chat ID autorizado (solo tú podrás controlar el bot)
ADMIN_CHAT_ID=7233007906

# ---------- AGENTE DE PC WINDOWS ----------
# Token de autenticación del agente local de PowerShell (pc-agent.ps1)
PC_AGENT_TOKEN=clave_secreta_para_tu_pc_aqui

# Tiempo en segundos tras el cual se considera la PC como apagada (offline)
PC_OFFLINE_THRESHOLD_SECONDS=35

# ---------- PERSISTENCIA ----------
DATA_DIR=/app/data
