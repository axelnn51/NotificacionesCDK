# ========================================================
# CDKeysPerú - Bot de Pedidos & Monitor de PC
# Archivo de ejemplo para Portainer / Docker / Local
# Copia este archivo como .env y rellena tus credenciales reales
# ========================================================

# ---------- SERVIDOR WEB (Express) ----------
PORT=3005
NODE_ENV=production
TZ=America/Lima

# ---------- TELEGRAM BOT ----------
# Token de tu bot obtenido de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui_ejemplo_123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat ID de Telegram donde recibirás las alertas (puedes poner múltiples separados por coma)
# Ejemplo: 7233007906 o 7233007906,-100123456789 (para grupos)
ADMIN_CHAT_ID=7233007906

# ---------- WOOCOMMERCE (Solo Lectura) ----------
# URL base de tu tienda WooCommerce
WC_URL=https://cdkeysperu.com

# Consumer Key y Consumer Secret generados en WooCommerce > Ajustes > Avanzado > REST API
# IMPORTANTE: Con permisos de "Solo Lectura" (Read) es suficiente para máxima seguridad
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Intervalo en segundos para consultar pedidos nuevos o cambios de estado (por defecto 30s)
POLL_INTERVAL_SECONDS=30

# Cantidad de pedidos recientes a rastrear en cada ciclo (por defecto 20)
POLL_BATCH_SIZE=20

# ---------- WEBHOOK WOOCOMMERCE (Opcional - Notificaciones Inmediatas) ----------
# Si configuras un Webhook en WooCommerce > Ajustes > Avanzado > Webhooks:
# URL de entrega: http://tu-ip-o-dominio:3005/webhook/woocommerce
# Tema: Pedido creado (action.woocommerce_new_order) y Pedido actualizado (woocommerce_order_updated)
WC_WEBHOOK_SECRET=tu_secreto_webhook_opcional

# ---------- CONTROL Y MONITOREO DE PC ----------
# Token secreto para comunicar el agente de tu PC con el Bot
# Puede ser cualquier clave segura que tú definas
PC_AGENT_TOKEN=clave_secreta_para_tu_pc_123456

# Tiempo en segundos tras el cual se considera la PC como apagada si no envía ping (por defecto 35s)
PC_OFFLINE_THRESHOLD_SECONDS=35

# ---------- DIRECTORIO DE DATOS ----------
DATA_DIR=./data
